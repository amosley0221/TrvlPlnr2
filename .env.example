# ────────────────────────────────────────────────────────────
# Backend (loaded by `npm run dev:server` via --env-file=.env)
# ────────────────────────────────────────────────────────────

# Your Anthropic API key. Required for the AI to do anything.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Port the Node server listens on. Vite proxies /api → here.
PORT=8787

# Comma-separated list of allowed origins for CORS. Use "*" for local dev.
# In production, set this to your static-site URL (e.g.
# https://trvlplnr.onrender.com).
CORS_ORIGIN=*


# ────────────────────────────────────────────────────────────
# Frontend (read by Vite at build time — VITE_ prefix required)
# ────────────────────────────────────────────────────────────

# Origin of the API service. Leave unset locally — the Vite dev server
# proxies /api to localhost:8787. Set in production (e.g.
# https://trvlplnr-api.onrender.com) so the built bundle knows where
# to send requests.
# VITE_API_URL=
